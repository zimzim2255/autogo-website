---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import cars from '../../data/cars.json';

export function getStaticPaths() {
  return cars.map(car => ({
    params: { slug: car.slug },
    props: { car }
  }));
}

const { car } = Astro.props;
const pageTitle = `${car.name} | AutoGo`;

function getSpecLabel(key: string): string {
  const labels: Record<string, string> = {
    motor: 'Moteur',
    engine: 'Moteur',
    battery: 'Batterie',
    autonomy: 'Autonomie',
    charging: 'Recharge',
    acceleration: 'Accélération',
    topSpeed: 'Vitesse max',
    power: 'Puissance',
    torque: 'Couple',
    fuelConsumption: 'Consommation',
    trunkCapacity: 'Coffre',
    seatingCapacity: 'Places'
  };
  return labels[key] || key;
}

function getSpecOrder(car: any): string[] {
  if (car.fuelType === 'Électrique') {
    return ['motor', 'battery', 'autonomy', 'charging', 'acceleration', 'topSpeed'];
  }
  if (car.fuelType === 'Hybride') {
    return ['engine', 'power', 'torque', 'acceleration', 'topSpeed', 'battery'];
  }
  // Essence/Diesel
  return ['engine', 'power', 'torque', 'fuelConsumption', 'topSpeed', 'trunkCapacity', 'seatingCapacity'];
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navbar />
    
    <main class="car-detail-page">
      <!-- Hero Section -->
      <section class="hero-section">
        <div class="hero-image">
          <img src={car.slug === 'dacia-logan' ? 'https://cdn.group.renault.com/dac/master/dacia-vn/vehicules/logan/logan-li1-ph2/herozone-banners/dacia-logan-li1-ph2-herozone-001-desktop.jpg.ximg.largex2.webp/27ae8c6dae.webp' : car.slug === 'peugeot-rifter' ? 'https://www.peugeot.ma/content/dam/peugeot/morocco/RIFTER-2880X1620.jpg?imwidth=1920' : car.slug === 'range-rover-sport' ? 'https://res.cloudinary.com/dqlr9mio4/image/upload/v1778765888/L46125GL_303104068_THE_SPY_003_DX_ALT_agfbgn.avif' : car.slug === 'ford-tourneo' ? 'https://live.dealer-asset.co/images/me1768/product/file/2022_FORD_TOURNEO_TITANIUM_011-638580427685356150.jpg?s=1024' : car.slug === 'peugeot-partner' ? 'https://res.cloudinary.com/dqlr9mio4/image/upload/v1778766875/1751390383686418af5c8260.21148260_what-type-of-van-is-a-peugeot-partner_kpprxm.webp' : car.image} alt={car.name} />
          {car.slug !== 'dacia-logan' && car.slug !== 'peugeot-rifter' && car.slug !== 'range-rover-sport' && car.slug !== 'ford-tourneo' && car.slug !== 'peugeot-partner' && <img src="https://www.peugeot.com/content/dam/peugeot/master/b2c/our-range/showroom/208/2023-10-new-208/mobile/PEUGEOT_E_208_2307STYP_090.jpg?imwidth=768" alt="New peugeot 208 with PEUGEOT i-COCKPIT®" class="detail-image" />}
        </div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <span class="vehicle-badge">DISPONIBLE À LA LOCATION</span>
          <h1>{car.name}</h1>
          <p class="hero-tagline" class:list={[car.slug === 'peugeot-rifter' || car.slug === 'range-rover-sport' ? 'white-tagline' : []]}>Conduisez le futur. Arrivez en silence.</p>
          <a href="#booking" class="cta-button">Voir les disponibilités →</a>
        </div>
        <div class="scroll-indicator" class:list={car.slug === 'peugeot-rifter' || car.slug === 'range-rover-sport' ? ['white-scroll'] : []}>
          <span>Faire défiler pour explorer</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M12 5L12 19M12 19L5 12M12 19L19 12" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
      </section>

      <!-- Vehicle Highlights -->
      <section class="highlights-section">
        <div class="highlights-grid">
          <div class="highlight-card">
            <div class="highlight-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>
              </svg>
            </div>
            <h3>PERFORMANCE ÉLECTRIQUE</h3>
            <p>Moteur silencieux de {car.year} avec accélération instantanée et zero émissions.</p>
          </div>
          <div class="highlight-card">
            <div class="highlight-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="6" width="18" height="12" rx="2"/>
                <path d="M7 12h10"/>
              </svg>
            </div>
            <h3>CABINE PREMIUM</h3>
            <p>Intérieur spacieux avec matériaux de haute qualité et confort optimal.</p>
          </div>
          <div class="highlight-card">
            <div class="highlight-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <h3>TECHNOLOGIE AVANCÉE</h3>
            <p>Système multimedia dernier cri et aides à la conduite intelligentes.</p>
          </div>
        </div>
      </section>

      <!-- Technical Specifications -->
      <section class="specs-section">
        <div class="specs-container">
          <div class="specs-image">
            <img src={car.image} alt={`${car.name} Interior`} />
          </div>
          <div class="specs-grid">
            <h2>SPÉCIFICATIONS TECHNIQUES</h2>
            {car.specs && getSpecOrder(car).map(key => {
              const value = car.specs[key];
              if (!value) return null;
              return (
                <div class="spec-item">
                  <span class="spec-label">{getSpecLabel(key)}</span>
                  <span class="spec-value">{value}</span>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- Booking Form -->
      <section id="booking" class="booking-section">
        <h2>RÉSERVER {car.name}</h2>
        <form class="booking-form" id="carBookingForm">
          <input type="hidden" name="car" value={car.slug} />
          <input type="hidden" name="vehicle" value={car.name} />
          <input type="hidden" name="formType" value="car-reservation" />
          
          <div class="form-group">
            <label for="fullName">Nom complet</label>
            <input type="text" id="fullName" name="fullName" placeholder="Votre nom complet" required />
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="votre.email@example.com" required />
          </div>
          
          <div class="form-group">
            <label for="phone">Téléphone</label>
            <input type="tel" id="phone" name="phone" placeholder="+212 6XX XXX XXX" required />
          </div>
          
          <div class="form-group">
            <label for="pickupLocation">Lieu de retrait</label>
            <input type="text" id="pickupLocation" name="pickupLocation" placeholder="Adresse ou lieu" required />
          </div>
          
          <div class="form-group">
            <label for="dropoffLocation">Lieu de retour</label>
            <input type="text" id="dropoffLocation" name="dropoffLocation" placeholder="Adresse ou lieu" required />
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label for="startDate">Date de début</label>
              <input type="date" id="startDate" name="startDate" required />
            </div>
            
            <div class="form-group">
              <label for="endDate">Date de fin</label>
              <input type="date" id="endDate" name="endDate" required />
            </div>
          </div>
          
           <button type="submit" class="submit-btn">Réserver maintenant</button>
           </form>
         </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  @font-face {
    font-family: 'Oswald';
    src: url('/fonts/Oswald/Oswald-VariableFont_wght.ttf') format('truetype');
    font-weight: 100 700;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Oswald', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: #f5f5f5;
    color: #000000;
    min-height: 100vh;
  }

  .car-detail-page {
    padding-top: 80px;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: flex-end;
    padding: 48px;
  }

  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-image .detail-image {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.3) 50%, transparent 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  .vehicle-badge {
    display: inline-block;
    padding: 8px 16px;
    background: rgba(182, 255, 0, 0.1);
    border: 1px solid #B6FF00;
    color: #B6FF00;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .hero-content h1 {
    font-size: 56px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 8px;
    line-height: 1.1;
  }

  .hero-tagline {
    font-size: 20px;
    color: rgba(0, 0, 0, 0.8);
    margin-bottom: 32px;
    font-style: italic;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 32px;
    background: #B6FF00;
    color: #000000;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .cta-button:hover {
    background: #f5f5f5;
    transform: scale(1.02);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 48px;
    right: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(0, 0, 0, 0.6);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* Highlights Section */
  .highlights-section {
    background: #f5f5f5;
    padding: 80px 48px;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #B6FF00;
    max-width: 1200px;
    margin: 0 auto;
  }

  .highlight-card {
    padding: 32px;
    background: #f5f5f5;
    transition: all 0.3s ease;
  }

  .highlight-card:hover {
    transform: translateY(-8px);
  }

  .highlight-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
    color: #B6FF00;
  }

  .highlight-card h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: 1px;
  }

  .highlight-card p {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.7);
  }

  /* Specs Section */
  .specs-section {
    background: #f5f5f5;
    color: #000000;
    padding: 80px 48px;
  }

  .specs-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

 .specs-image {
     background: #f5f5f5;
     padding: 8px;
   }

    .specs-image img {
      width: 100%;
      height: 700px;
      object-fit: contain;
      background: #f5f5f5;
    }

  .specs-image {
    border: none;
  }

  .specs-grid h2 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 40px;
    letter-spacing: 2px;
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid rgba(182, 255, 0, 0.3);
  }

  .spec-label {
    font-size: 14px;
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .spec-value {
    font-size: 16px;
    font-weight: 500;
    color: #B6FF00;
  }

  /* Booking Section */
  .booking-section {
    padding: 80px 48px;
    text-align: center;
    background: #f5f5f5;
  }

  .booking-section h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 40px;
    letter-spacing: 2px;
  }

  .booking-form {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .form-group input,
  .form-group select {
    padding: 16px;
    background: #f5f5f5;
    border: 1px solid rgba(182, 255, 0, 0.3);
    color: #000000;
    font-size: 16px;
    font-family: 'Oswald', -apple-system, BlinkMacSystemFont, sans-serif;
    transition: all 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: #B6FF00;
    background: rgba(182, 255, 0, 0.05);
  }

  .form-group select {
    cursor: pointer;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .submit-btn {
    padding: 20px 48px;
    background: #B6FF00;
    color: #000000;
    border: none;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 16px;
  }

   .submit-btn:hover {
     background: #f5f5f5;
   }

   .white-tagline {
     color: #ffffff !important;
   }

   .white-scroll {
     color: #ffffff !important;
   }

   .booking-title-box {
     display: inline-block;
     padding: 16px 32px;
     border: 2px solid #B6FF00;
     border-radius: 4px;
     margin-bottom: 40px;
   }

   .booking-title-box h2 {
     font-size: 24px;
     font-weight: 700;
     letter-spacing: 2px;
     color: #000000;
     margin: 0;
   }

   .form-box {
     display: inline-block;
     padding: 40px;
     border: 2px solid #B6FF00;
     border-radius: 8px;
     background: #f5f5f5;
     max-width: 600px;
     text-align: left;
   }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero-section {
      padding: 24px;
      height: 80vh;
    }

    .hero-content h1 {
      font-size: 32px;
    }

    .scroll-indicator {
      display: none;
    }

    .highlights-grid {
      grid-template-columns: 1fr;
    }

    .booking-section {
      padding: 48px 16px;
    }

    .booking-section h2 {
      font-size: 24px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .submit-btn {
      width: 100%;
    }

    .specs-container {
      grid-template-columns: 1fr;
    }

      .specs-image img {
        height: 500px;
      }
  }
</style>

<script>
  // @ts-ignore
  const form = document.getElementById('carBookingForm') as HTMLFormElement;
  
  form?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    
    // Get form data
    const formData = new FormData(form);
    const data: Record<string, string> = {
      email: (formData.get('email') as string) || '',
      fullName: (formData.get('fullName') as string) || '',
      phone: (formData.get('phone') as string) || '',
      vehicle: (formData.get('vehicle') as string) || '',
      pickupLocation: (formData.get('pickupLocation') as string) || '',
      dropoffLocation: (formData.get('dropoffLocation') as string) || '',
      startDate: (formData.get('startDate') as string) || '',
      endDate: (formData.get('endDate') as string) || '',
      formType: (formData.get('formType') as string) || 'car-reservation',
      message: `New Car Reservation:\nVehicle: ${formData.get('vehicle')}\nClient: ${formData.get('fullName')}\nPhone: ${formData.get('phone')}\nPickup: ${formData.get('pickupLocation')}\nDropoff: ${formData.get('dropoffLocation')}\nDates: ${formData.get('startDate')} to ${formData.get('endDate')}`
    };
    
    try {
      // Submit to Formspree
      const response = await fetch('https://formspree.io/f/xnjlrayw', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(data)
      });
      
      if (response.ok) {
        // Build redirect URL with query parameters
        const params = new URLSearchParams([
          ['fullName', (formData.get('fullName') as string) || ''],
          ['email', (formData.get('email') as string) || ''],
          ['phone', (formData.get('phone') as string) || ''],
          ['vehicle', (formData.get('car') as string) || (formData.get('vehicle') as string) || ''],
          ['pickupLocation', (formData.get('pickupLocation') as string) || ''],
          ['dropoffLocation', (formData.get('dropoffLocation') as string) || ''],
          ['startDate', (formData.get('startDate') as string) || ''],
          ['endDate', (formData.get('endDate') as string) || ''],
          ['source', 'car-detail']
        ]);
        
        window.location.href = '/reservation-confirmed?' + params.toString();
      } else {
        alert('Erreur lors de l\'envoi. Veuillez réessayer.');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Erreur lors de l\'envoi. Veuillez vérifier votre connexion.');
    }
  });

  // Pre-fill form fields from URL parameters (from homepage booking bar)
  window.addEventListener('load', function() {
    const params = new URLSearchParams(window.location.search);
    const phoneValue = params.get('phone');
    const emailValue = params.get('email');
    const locationValue = params.get('location');
    const pickupValue = params.get('pickup');
    const dropoffValue = params.get('dropoff');
    
    const phoneInput = document.getElementById('phone') as HTMLInputElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const pickupLocationInput = document.getElementById('pickupLocation') as HTMLInputElement;
    const dropoffLocationInput = document.getElementById('dropoffLocation') as HTMLInputElement;
    const startDateInput = document.getElementById('startDate') as HTMLInputElement;
    const endDateInput = document.getElementById('endDate') as HTMLInputElement;
    
    if (phoneValue && phoneInput) phoneInput.value = decodeURIComponent(phoneValue);
    if (emailValue && emailInput) emailInput.value = decodeURIComponent(emailValue);
    if (locationValue && pickupLocationInput) pickupLocationInput.value = decodeURIComponent(locationValue);
    if (locationValue && dropoffLocationInput) dropoffLocationInput.value = decodeURIComponent(locationValue);
    if (pickupValue && startDateInput) startDateInput.value = pickupValue;
    if (dropoffValue && endDateInput) endDateInput.value = dropoffValue;
  });
</script>